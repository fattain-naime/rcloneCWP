#!/usr/bin/env php
<?php
/**
 * rclone-restore — Dedicated snapshot inspection & account restore CLI
 *
 * Usage:
 *   rclone-restore list <destination_id> [--json]
 *   rclone-restore inspect <destination_id> <snapshot_path> [--json]
 *   rclone-restore run <destination_id> <snapshot_path> <username> [--components=c1,c2] [--json]
 */

require_once __DIR__ . '/bootstrap.php';

use CWP\RcloneCWP\CLI;

// Rewrite argv to prepend 'restore' command
$newArgv = [$argv[0], 'restore'];
for ($i = 1; $i < count($argv); $i++) {
    $newArgv[] = $argv[$i];
}

exit(CLI::main($newArgv));
