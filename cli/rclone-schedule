#!/usr/bin/env php
<?php
/**
 * rclone-schedule — Dedicated backup schedule & cron runner CLI
 *
 * Usage:
 *   rclone-schedule list [--json]
 *   rclone-schedule show <id> [--json]
 *   rclone-schedule enable|disable <id>
 *   rclone-schedule run-due [--json]
 */

require_once __DIR__ . '/bootstrap.php';

use CWP\RcloneCWP\CLI;

// Rewrite argv to prepend 'schedule' command
$newArgv = [$argv[0], 'schedule'];
for ($i = 1; $i < count($argv); $i++) {
    $newArgv[] = $argv[$i];
}

exit(CLI::main($newArgv));
