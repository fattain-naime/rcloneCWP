{
    "name": "fattain-naime/rclonecwp",
    "description": "Rclone backup module for CentOS WebPanel",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5",
        "phpunit/php-code-coverage": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "CWP\\RcloneCWP\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CWP\\RcloneCWP\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c tests/phpunit.xml",
        "test-unit": "phpunit -c tests/phpunit.xml --testsuite \"Unit Tests\"",
        "test-integration": "phpunit -c tests/phpunit.xml --testsuite \"Integration Tests\"",
        "coverage": "phpunit -c tests/phpunit.xml --coverage-html tests/coverage"
    }
}